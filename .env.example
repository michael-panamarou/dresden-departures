# Copy this file to .env.local and adjust the values:
#   cp .env.example .env.local
#
# Never put real secrets in this file. It is committed to Git.

# ── Transit data ──────────────────────────────────────────────────────────
# 1 = use built-in sample data instead of the VVO API (offline, VVO down, tests)
# 0 = use the real VVO API (default)
VVO_MOCK=0

# ── Optional: favourites (GitHub login + database) ────────────────────────
# Leave these empty and the app works without sign-in. Fill in ALL four to switch
# favourites on. Step-by-step setup: README.md → "Enable favourites".

# Random secret that encrypts the login cookie. Create one with: npx auth secret
AUTH_SECRET=

# From your GitHub OAuth app (github.com → Settings → Developer settings → OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# PostgreSQL connection string, e.g. from a free Neon database (neon.tech):
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
